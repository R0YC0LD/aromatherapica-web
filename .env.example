NODE_ENV=development

# Admin panel (development defaults — change in production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345
SESSION_SECRET=change-this-with-a-long-random-secret-at-least-32-chars

# Ticimax SOAP (sample App.config: AlanAdi + YetkiKodu)
# Example: https://your-store.com/servis
TICIMAX_BASE_URL=
TICIMAX_UYE_KODU=
TICIMAX_ALAN_ADI=
TICIMAX_STORE_URL=

# SQLite (default) or PostgreSQL connection string
DATABASE_URL="file:./dev.db"

# Protects /api/cron/* endpoints
CRON_SECRET=change-me-cron-secret

# Payment: havale/eft or kapıda ödeme via Ticimax SaveSiparis only
# Card data is never processed by this app.
DEFAULT_PAYMENT_TYPE=1
DEFAULT_PAYMENT_OPTION_ID=1
DEFAULT_CARGO_COMPANY_ID=1
