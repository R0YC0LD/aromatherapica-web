generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  username  String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model SyncRun {
  id           String      @id @default(cuid())
  type         String
  status       String
  startedAt    DateTime    @default(now())
  finishedAt   DateTime?
  successCount Int         @default(0)
  failureCount Int         @default(0)
  message      String?
  errors       SyncError[]
}

model SyncError {
  id         String   @id @default(cuid())
  syncRunId  String
  syncRun    SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String?
  message    String
  payload    String?
  retryCount Int      @default(0)
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([syncRunId])
  @@index([resolved, createdAt])
}

model ProductCache {
  ticimaxId  Int      @id
  slug       String   @unique
  name       String
  categoryId Int?
  brandId    Int?
  price      Float
  salePrice  Float?
  stock      Int
  active     Boolean  @default(true)
  imageUrl   String?
  raw        String
  syncedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([categoryId, active])
  @@index([active, stock])
}

model CategoryCache {
  ticimaxId Int      @id
  parentId  Int      @default(0)
  slug      String   @unique
  name      String
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  seoTitle  String?
  seoDesc   String?
  raw       String
  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId, active])
}

model LocalOrder {
  id               String   @id @default(cuid())
  idempotencyKey   String   @unique
  ticimaxOrderId   Int?
  ticimaxOrderCode String?
  status           String   @default("PENDING")
  paymentStatus    String   @default("PENDING")
  paymentType      Int?
  totalAmount      Float
  currency         String   @default("TRY")
  customerEmail    String
  customerName     String?
  ticimaxMemberId  Int?
  payload          String
  paymentVerified  Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, createdAt])
  @@index([ticimaxOrderId])
}

model ApiLog {
  id           String   @id @default(cuid())
  service      String
  operation    String
  durationMs   Int
  success      Boolean
  statusCode   Int?
  recordCount  Int?
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([service, createdAt])
  @@index([success, createdAt])
}

model CustomerSession {
  id              String   @id @default(cuid())
  sessionToken    String   @unique
  ticimaxMemberId Int?
  email           String?
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model AppMeta {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
